# App Alquiler Backend Environment Variables

# Server Configuration
PORT=3001
HOST=localhost

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_alquiler_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_SIZE=10

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRATION=3600

# Environment
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:8101