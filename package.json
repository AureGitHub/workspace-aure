{
  "name": "workspace-aure",
  "version": "1.0.0",
  "description": "Workspace multiaplicación con Frontend (Ionic 8 + Angular 20 + PrimeNG 20.3.0) y Backend (Deno.js + Oak + PostgreSQL)",
  "private": true,
  "workspaces": [
    "frontend/*"
  ],
  "scripts": {
    "start:portal": "cd frontend/portal && ng serve --port=8100",
    "start:app-alquiler": "cd frontend/app-alquiler && ng serve --port=8101",
    "start:app2": "cd frontend/app2 && ng serve --port=8102",
    "start:backend-alquiler": "cd backend/app-alquiler && deno task dev",
    "start:backend-alquiler-prod": "cd backend/app-alquiler && deno task start",
    "build:all": "npm run build:shared && npm run build:portal && npm run build:app-alquiler && npm run build:app2",
    "build:shared": "cd frontend/shared-lib && ng build",
    "build:portal": "cd frontend/portal && ng build",
    "build:app-alquiler": "cd frontend/app-alquiler && ng build",
    "build:app2": "cd frontend/app2 && ng build",
    "backend:check": "cd backend/app-alquiler && deno task check",
    "backend:fmt": "cd backend/app-alquiler && deno task fmt",
    "backend:lint": "cd backend/app-alquiler && deno task lint",
    "backend:test": "cd backend/app-alquiler && deno task test",
    "install:all": "npm install",
    "clean:node_modules": "rm -rf node_modules frontend/*/node_modules",
    "fresh:install": "npm run clean:node_modules && npm install"
  },
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@capacitor/app": "7.1.0",
    "@capacitor/core": "7.4.4",
    "@capacitor/haptics": "7.0.2",
    "@capacitor/keyboard": "7.0.3",
    "@capacitor/status-bar": "7.0.3",
    "@fortawesome/angular-fontawesome": "^3.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-solid-svg-icons": "^7.1.0",
    "@ionic/angular": "^8.0.0",
    "ionicons": "^7.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.3.0",
    "remixicon": "^4.7.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular-eslint/builder": "^20.0.0",
    "@angular-eslint/eslint-plugin": "^20.0.0",
    "@angular-eslint/eslint-plugin-template": "^20.0.0",
    "@angular-eslint/schematics": "^20.0.0",
    "@angular-eslint/template-parser": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@angular/language-service": "^20.0.0",
    "@capacitor/cli": "7.4.4",
    "@ionic/angular-toolkit": "^12.0.0",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.16.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^48.2.1",
    "eslint-plugin-prefer-arrow": "1.2.2",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.0"
  },
  "keywords": [
    "ionic",
    "angular",
    "primeng",
    "deno",
    "oak",
    "postgresql",
    "jwt",
    "workspace",
    "multiaplicacion",
    "monorepo"
  ],
  "author": "Workspace Aure Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
